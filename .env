PIMCORE_KERNEL_CLASS=Kernel
DEFUSE_SECRET=
APP_DEBUG=1

###> coreshop/pimcore-mcp-bundle ###
# MCP API token for AI client authentication (Bearer token)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
MCP_API_TOKEN=
# Pimcore admin username to authenticate MCP requests as (default: admin)
# MCP_ADMIN_USERNAME=admin
###< coreshop/pimcore-mcp-bundle ###
