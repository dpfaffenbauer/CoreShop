{% import "@CoreShopFrontend/Common/Macro/currency.html.twig" as currency %}
{% extends '@CoreShopFrontend/layout-full.html.twig' %}

{% block center %}
    <div id="main-container" class="container p-0">

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('coreshop_index') }}">{{ 'coreshop.ui.home'|trans }}</a></li>
                <li class="breadcrumb-item"><a href="{{ path('coreshop_customer_profile') }}">{{ 'coreshop.ui.profile'|trans }}</a></li>
                <li class="breadcrumb-item"><a href="{{ path('coreshop_customer_orders') }}">{{ 'coreshop.ui.orders'|trans }}</a></li>
                <li class="breadcrumb-item">
                    <a href="{{ path('coreshop_customer_order_detail', {order: order.id}) }}">
                        {{ 'coreshop.ui.order'|trans }} {{ order.orderNumber }}
                    </a>
                </li>
                <li class="breadcrumb-item active">{{ 'coreshop.ui.request_return'|trans }}</li>
            </ol>
        </nav>

        <div class="row">
            {% include '@CoreShopFrontend/Customer/_sidebar.html.twig' %}

            <div class="col-12 col-lg-9">
                <h3>{{ 'coreshop.ui.request_return'|trans }}</h3>
                <p class="text-muted">{{ 'coreshop.ui.select_items_to_return'|trans }}</p>

                {% include '@CoreShopFrontend/Common/flash_messages.html.twig' %}

                {{ form_start(form, {'attr': {'class': 'mt-3'}}) }}

                <table class="table">
                    <thead>
                    <tr>
                        <th>{{ 'coreshop.ui.item'|trans }}</th>
                        <th class="text-end">{{ 'coreshop.ui.price'|trans }}</th>
                        <th class="text-center">{{ 'coreshop.ui.available'|trans }}</th>
                        <th class="text-center">{{ 'coreshop.ui.quantity_to_return'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for index, entry in returnableItems %}
                        {% set orderItem = entry.orderItem %}
                        {% set maxQty = entry.maxQuantity %}
                        <tr>
                            <td class="align-middle">
                                <div class="d-flex align-items-center gap-2">
                                    {% if orderItem.product is defined and orderItem.product and orderItem.product.image is defined and orderItem.product.image is pimcore_asset_image %}
                                        {{ orderItem.product.image|pimcore_image_thumbnail_html('coreshop_productCartPreview', {'imgAttributes': {'class': 'img-fluid', 'style': 'max-width: 50px;'}}) }}
                                    {% endif %}
                                    <span>{{ orderItem.name }}</span>
                                </div>
                            </td>
                            <td class="align-middle text-end">
                                {{ currency.format(orderItem.itemPrice, order.currency.isoCode) }}
                            </td>
                            <td class="align-middle text-center">
                                {{ maxQty }}
                            </td>
                            <td class="align-middle text-center">
                                <input type="hidden"
                                       name="coreshop_order_return[items][{{ index }}][orderItemId]"
                                       value="{{ orderItem.id }}">
                                <input type="number"
                                       name="coreshop_order_return[items][{{ index }}][quantity]"
                                       class="form-control text-center"
                                       style="width: 80px; display: inline-block;"
                                       min="0"
                                       max="{{ maxQty }}"
                                       value="0">
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <div class="d-flex justify-content-between mt-3">
                    <a href="{{ path('coreshop_customer_order_detail', {order: order.id}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        {{ 'coreshop.ui.cancel'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-arrow-return-left me-1"></i>
                        {{ 'coreshop.ui.create_return'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
