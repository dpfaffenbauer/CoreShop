{
    "name": "coreshop/subscription-bundle",
    "type": "pimcore-bundle",
    "description": "CoreShop - Subscription Bundle",
    "keywords": [
        "coreshop",
        "pimcore",
        "ecommerce",
        "subscription"
    ],
    "homepage": "https://www.coreshop.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "CoreShop Team",
            "email": "info@coreshop.com",
            "homepage": "https://www.coreshop.com/",
            "role": "Developer"
        },
        {
            "name": "Dominik Pfaffenbauer",
            "email": "dominik@pfaffenbauer.at",
            "homepage": "https://www.pfaffenbauer.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "coreshop/subscription": "^5.0",
        "coreshop/order-bundle": "^5.0",
        "coreshop/resource-bundle": "^5.0",
        "coreshop/store-bundle": "^5.0",
        "coreshop/currency-bundle": "^5.0",
        "coreshop/workflow-bundle": "^5.0",
        "pimcore/pimcore": "^12.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "pimcore/studio-ui-bundle": "^0.6.30"
    },
    "autoload": {
        "psr-4": {
            "CoreShop\\Bundle\\SubscriptionBundle\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "5.0-dev",
            "dev-master": "5.0-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "pimcore/studio-ui-bundle": "^0.6.30 - Modern React-based Studio UI for Pimcore (recommended)"
    }
}
